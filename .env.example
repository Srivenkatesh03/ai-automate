# ════════════════════════════════════════════════════════════════
# AI AUTOMATE PLATFORM - ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# ════════════════════════════════════════════════════════════════
# ENVIRONMENT
# ════════════════════════════════════════════════════════════════
NODE_ENV=development
TIMEZONE=UTC

# ════════════════════════════════════════════════════════════════
# DATABASE - PostgreSQL
# ════════════════════════════════════════════════════════════════
DB_HOST=postgres
DB_PORT=5432
DB_USER=aiuser
DB_PASSWORD=aipassword123
DB_NAME=ai_automate_db

# For production, use a strong password
# DB_PASSWORD=your-very-strong-password-here

# ════════════════════════════════════════════════════════════════
# REDIS - Job Queue & Caching
# ════════════════════════════════════════════════════════════════
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword123

# ════════════════════════════════════════════════════════════════
# BACKEND API
# ════════════════════════════════════════════════════════════════
BACKEND_PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
CORS_ORIGIN=http://localhost:3001

# ════════════════════════════════════════════════════════════════
# FRONTEND
# ════════════════════════════════════════════════════════════════
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# ════════════════════════════════════════════════════════════════
# N8N - WORKFLOW AUTOMATION PLATFORM
# ════════════════════════════════════════════════════════════════
N8N_PORT=5678
N8N_USER=admin@example.com
N8N_PASSWORD=n8npassword123
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=your-n8n-api-key-here

# ════════════════════════════════════════════════════════════════
# AI PROVIDERS
# ════════════════════════════════════════════════════════════════

# OpenAI API Key (for GPT-4, GPT-3.5-turbo)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Claude API Key (Anthropic)
# Get from: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your-claude-key-here

# ════════════════════════════════════════════════════════════════
# EMAIL NOTIFICATIONS - Gmail SMTP
# ════════════════════════════════════════════════════════════════
# Use Gmail App Password (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-password-here
GMAIL_FROM_NAME=AI Automate Platform

# ════════════════════════════════════════════════════════════════
# SLACK INTEGRATION
# ════════════════════════════════════════════════════════════════
# Create Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ════════════════════════════════════════════════════════════════
# DISCORD INTEGRATION (Optional)
# ════════════════════════════════════════════════════════════════
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# ════════════════════════════════════════════════════════════════
# FILE UPLOADS
# ════════════════════════════════════════════════════════════════
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,png,csv,xlsx
UPLOAD_DIR=./backend/uploads

# ════════════════════════════════════════════════════════════════
# LOGGING & MONITORING
# ════════════════════════════════════════════════════════════════
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ════════════════════════════════════════════════════════════════
# NGINX (Production)
# ════════════════════════════════════════════════════════════════
NGINX_PORT=80
NGINX_SSL_PORT=443
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ════════════════════════════════════════════════════════════════
# EXTERNAL SERVICES (Optional)
# ════════════════════════════════════════════════════════════════

# AWS S3 for document storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Stripe for payments
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# ════════════════════════════════════════════════════════════════
# SECURITY
# ════════════════════════════════════════════════════════════════
# Webhook signature secret (for validating incoming webhooks)
WEBHOOK_SECRET=your-webhook-secret-key-here
WEBHOOK_TIMEOUT=30000  # 30 seconds

# Rate limiting
RATE_LIMIT_WINDOW=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ════════════════════════════════════════════════════════════════
# DEVELOPMENT ONLY
# ════════════════════════════════════════════════════════════════
DEBUG=false
DEV_MODE=true
